
# =====================================================
# MercadoLibre AppSec GenAI Challenge
# Environment Configuration Template
# =====================================================
#
# Copy this file to .env and configure your environment.
#
# SECURITY:
# - Never commit .env to Git.
# - Never store passwords or access tokens here.
# - .env.example must contain placeholders only.
# =====================================================


# =====================================================
# APPLICATION ENVIRONMENT
# =====================================================

# development | production
APP_ENV=development


# =====================================================
# AUTH0 - IDENTITY PROVIDER
# =====================================================

# Auth0 tenant domain
# Do not include https:// or trailing slash.
AUTH0_DOMAIN=dev-folaintr50r7slgy.auth0.com

# Audience configured in Auth0 custom API
AUTH0_AUDIENCE=https://appsec-api.local

# Allowed OAuth client IDs
# Corresponds to AppSec GenAI CLI
# Multiple IDs must be separated by commas.
AUTH0_ALLOWED_CLIENT_IDS=tEPGOBfpUK4AzNCE5TGiB7r3hB2yAB7l


# =====================================================
# AUTH0 - NATIVE CLIENT (FUTURE LOGIN INTEGRATION)
# =====================================================

# Public OAuth Client ID (not a secret)
AUTH0_CLIENT_ID=tEPGOBfpUK4AzNCE5TGiB7r3hB2yAB7l

# OAuth Authorization Code + PKCE callback
AUTH0_REDIRECT_URI=http://127.0.0.1:8765/callback


# =====================================================
# OLLAMA - LOCAL LLM
# =====================================================

# Ollama REST API
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Local code analysis model
OLLAMA_MODEL=qwen2.5-coder:7b


# =====================================================
# FASTAPI - LOCAL SERVER
# =====================================================

# Reference for future CLI configuration
APPSEC_API_URL=http://127.0.0.1:8000

# Authentication and authorization must be enforced
# in FastAPI, not controlled by a client-side flag.


# =====================================================
# SECURITY NOTES
# =====================================================

# Never disable JWT signature verification.
# Use HTTPS when exposing services beyond localhost.
# Never expose Ollama directly to untrusted networks.
# Store real credentials outside the Git repository.
