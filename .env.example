
# ==============================================================
# MERCADOLIBRE APPSEC GENAI CHALLENGE
# Environment Configuration Template
# ==============================================================
#
# PURPOSE:
# Template for configuring the local AppSec GenAI server
# and its OAuth 2.0 client.
#
# SETUP:
# 1. Copy this file to .env
# 2. Replace all required placeholders
# 3. Keep .env outside Git version control
#
# SECURITY REQUIREMENTS:
# - NEVER commit .env.
# - NEVER commit private signing keys.
# - NEVER store passwords or access tokens here.
# - Use real credentials only in your private .env.
# - Keep signing operations on a trusted server.
# - All values in this template must be non-sensitive.
# ==============================================================


# ==============================================================
# 1. APPLICATION ENVIRONMENT
# ==============================================================

# Supported environment names:
# development | production
#
# Production deployments require additional hardening,
# TLS termination and infrastructure isolation.
APP_ENV=development


# ==============================================================
# 2. AUTH0 - IDENTITY PROVIDER
# ==============================================================

# Exact Auth0 tenant domain.
#
# Copy the domain from the Auth0 dashboard.
# Some tenants include a regional suffix such as:
# dev-example.us.auth0.com
#
# Do NOT include https:// or a trailing slash.
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com


# Auth0 Custom API Identifier (audience).
#
# This must match the Identifier configured in:
# Auth0 Dashboard -> Applications -> APIs.
#
# This is an OAuth audience, NOT the FastAPI URL.
AUTH0_AUDIENCE=https://appsec-api.local


# OAuth application IDs authorized to call FastAPI.
#
# This is a server-side allowlist of trusted OAuth
# clients, not a list of users or roles.
#
# Multiple client IDs may be separated by commas.
#
# Example:
# AUTH0_ALLOWED_CLIENT_IDS=CLIENT_ID_1,CLIENT_ID_2
AUTH0_ALLOWED_CLIENT_IDS=YOUR_NATIVE_CLIENT_ID


# ==============================================================
# 3. AUTH0 - NATIVE CLIENT / OAUTH 2.0 + PKCE
# ==============================================================

# Application type:
# Native Application
#
# OAuth flow:
# Authorization Code + PKCE (S256)
#
# The Client ID is public information.
# Never use a client secret in the native CLI.
AUTH0_CLIENT_ID=YOUR_NATIVE_CLIENT_ID


# Exact callback configured in Auth0.
#
# Allowed Callback URL:
# http://127.0.0.1:8765/callback
#
# The client validates state, nonce and the
# identity token before accepting authentication.
AUTH0_REDIRECT_URI=http://127.0.0.1:8765/callback


# Required Auth0 API permissions:
#
# analyze:code
#   Permission for developers to analyze code.
#
# review:findings
#   Reserved for the AppSec reviewer role.
#
# Enable RBAC and include permissions in the
# access token in the Auth0 API configuration.
#
# Do not grant review:findings to ordinary developers.
#
# Permissions are configured in Auth0, not in .env.


# ==============================================================
# 4. OLLAMA - LOCAL LLM SERVICE
# ==============================================================

# Ollama API endpoint.
#
# The backend sends source code to this service
# for security analysis.
#
# Keep the service bound to localhost for this lab.
OLLAMA_URL=http://127.0.0.1:11434/api/chat


# Local LLM used for security code review.
#
# Install it with:
# ollama pull qwen2.5-coder:7b
OLLAMA_MODEL=qwen2.5-coder:7b


# ==============================================================
# 5. FASTAPI - APPSEC ANALYSIS SERVER
# ==============================================================

# Trusted analysis API endpoint for the local CLI
# and pre-commit hook.
#
# The current hook is configured to trust:
# http://127.0.0.1:8000
#
# Do not point this variable to an arbitrary host.
APPSEC_API_URL=http://127.0.0.1:8000


# Start the API from the repository root:
#
# python -m uvicorn backend.main:app \
#   --host 127.0.0.1 \
#   --port 8000 \
#   --env-file .env
#
# On Windows PowerShell, use a single command line.
#
# Authentication, authorization, security policy
# and signature generation are enforced server-side.


# ==============================================================
# 6. ED25519 - SERVER-SIDE COMMIT ATTESTATIONS
# ==============================================================

# Repository identity authorized for signed analyses.
#
# Must match the owner/repository used by the
# trusted Git verifier and GitHub Actions workflow.
#
# Example:
# example-user/appsec-genai-challenge
APPSEC_REPOSITORY=YOUR_GITHUB_USERNAME/appsec-genai-challenge


# Identifier of the trusted Ed25519 signing key.
#
# Must match the ID associated with the public key
# published at:
#
# .github/appsec/keys/<APPSEC_SIGNING_KEY_ID>.pem
#
# The ID must correspond to the real public key.
# It is NOT a password or random access token.
#
# Replace this placeholder with your existing key ID.
APPSEC_SIGNING_KEY_ID=lab-REPLACE_WITH_PUBLIC_KEY_ID


# Absolute path to the Ed25519 PRIVATE signing key.
#
# IMPORTANT:
# - The private key MUST remain outside the repository.
# - Restrict filesystem access to the trusted server.
# - Never provide this path or key to untrusted users.
# - Never upload the private key to GitHub.
#
# Windows example using forward slashes:
APPSEC_SIGNING_KEY_PATH=C:/Users/YOUR_WINDOWS_USER/AppData/Local/AppSecGenAI/keys/signing.pem


# Public key distribution:
#
# .github/appsec/keys/<KEY_ID>.pem
#
# Public keys may be versioned.
# Private keys must never be versioned.
#
# GitHub Actions verifies signed attestations
# without receiving the private signing key.


# ==============================================================
# 7. GIT INTEGRITY AND POLICY VERIFICATION
# ==============================================================

# The signed manifest binds security analysis to:
#
# - Git tree object
# - Parent commit
# - Analyzed file paths and content hashes
# - Trusted security policy SHA-256
# - Repository identity
# - Authorized signing key
#
# The integrity of the commit is verified remotely
# by GitHub Actions.
#
# Required GitHub status check:
# appsec-integrity/verified
#
# These properties are calculated by application
# code and do not require extra .env variables.
#
# Never weaken integrity checks to make a
# failed Pull Request pass.


# ==============================================================
# 8. LOCAL AUTHENTICATION AND TOKEN STORAGE
# ==============================================================

# The native OAuth client uses Authorization Code
# with PKCE and a loopback callback.
#
# Login:
# python -m auth_client.login
#
# Access tokens are stored using the supported
# operating-system credential store via keyring.
#
# Do NOT place access tokens in this .env file.
#
# Refresh tokens are not required by the current
# local workflow. Reauthenticate when necessary.


# ==============================================================
# 9. OPTIONAL CHROME CONFIGURATION
# ==============================================================

# The native login client can launch Google Chrome.
#
# If Chrome is installed in a non-standard location,
# configure its executable path.
#
# Leave commented if Chrome is detected automatically.
#
# APPSEC_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe


# ==============================================================
# 10. SECURITY AND DEPLOYMENT NOTES
# ==============================================================

# AUTHENTICATION
# - Validate JWT signatures using trusted Auth0 JWKS.
# - Validate issuer, audience, expiry and client identity.
# - Enforce permissions on FastAPI endpoints.
# - Never trust role or permission claims from the client UI.
#
# LLM SECURITY
# - Treat submitted source code as untrusted data.
# - Never execute submitted code during analysis.
# - Do not obey instructions embedded in source code.
# - Validate structured LLM responses and evidence.
# - Never treat an LLM-only finding as confirmed.
#
# INTEGRITY
# - Keep the Ed25519 private key outside Git.
# - Require the GitHub integrity status check.
# - Never trust local hook execution as proof of approval.
# - Reject missing, forged or inconsistent attestations.
#
# NETWORK
# - Do not expose Ollama to untrusted networks.
# - Use HTTPS when exposing services beyond localhost.
# - Restrict API and signing-service access.
#
# SECRETS
# - Never commit .env, JWTs, passwords or private keys.
# - Use dedicated secret management in production.
# - Rotate compromised credentials and signing keys.
#
# ==============================================================
# END OF CONFIGURATION TEMPLATE
# ==============================================================
